# Copy to .env -- do not retype. .env.example is LF-normalised by
# .gitattributes, and a CRLF .env is read differently by Docker Compose
# and by Python's dotenv parser.
POSTGRES_USER=txnsvc
# Local development only. The postgres image REFUSES to initialise a fresh
# data directory when this is empty, so it must have a value.
POSTGRES_PASSWORD=local_dev_only
POSTGRES_DB=txnsvc
# 5433, not 5432, so the stack cannot collide with a PostgreSQL already
# installed on the host.
POSTGRES_PORT=5433
REDIS_PORT=6379
# A single host port. Set to a range (8000-8002) only when scaling the API
# with --scale api=3.
API_PORTS=8000

# --- identity -------------------------------------------------------------
# Every sign-up opens one account with this balance, recorded as a genesis
# credit so the money has an origin the ledger can explain. A demo affordance.
SIGNUP_CURRENCY=SAR
SIGNUP_OPENING_BALANCE=1000.0000
SESSION_LIFETIME_HOURS=12
# Browsers refuse Secure cookies over plain http, so this must stay false for
# local development and must become true for anything reachable over a network.
COOKIE_SECURE=false

# The administrator, created and kept up to date by the API at boot. There is
# no API path that creates an admin, by design. Leave all three blank for none.
# DEV ONLY -- this file is committed, so these values are public.
ADMIN_FULL_NAME=Bank Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin_dev_only
